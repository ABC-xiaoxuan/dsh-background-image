{
  "name": "dsh-background-image",
  "version": "1.3.3",
  "description": "DeepSeek Harness 本地背景图片插件",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "dsh.bundle.patch", "README.md"],
  "engines": { "node": ">=22", "dsh": ">=0.2.0-rc.2 <0.3.0" },
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./dsh.bundle.patch" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-renderer"]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs"
  }
}
